{
  "manifest_version": 3,
  "name": "Infinity Dex Helper",
  "version": "1.9.2",
  "description": "Companion do InfinityMMO: dados de batalha ao vivo, melhor jogada e dano estimado, Pokédex e Meus Pokémon.",
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*", "https://raw.githubusercontent.com/gustavoard18-design/pokemon-infinity-mmo-extension/*"],
  "content_scripts": [
    {
      "matches": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "battle.html",
        "battle.js",
        "chart.html",
        "chart.js",
        "pixel-theme.css",
        "myPokemons.html",
        "myPokemons.js",
        "pokedex.html",
        "pokedex.js",
        "spawns.html",
        "spawns.js",
        "farm.html",
        "farm.js",
        "components/*.js",
        "components/*.css",
        "data/*.js",
        "icons/types/*.png",
        "icons/types/colored/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
