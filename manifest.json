{
  "manifest_version": 3,
  "name": "Infinity MMO Extension",
  "version": "1.4.52",
  "description": "Overlay para Infinity MMO com dados de batalha, calculadora de tipos, Party/PC e ferramentas de leilão.",
  "icons": {
    "16": "icons/extension-16.png",
    "32": "icons/extension-32.png",
    "48": "icons/extension-48.png",
    "128": "icons/extension-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/extension-16.png",
      "32": "icons/extension-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "alarms", "scripting", "storage"],
  "host_permissions": ["*://infinitymmo.net/*", "*://*.infinitymmo.net/*", "https://raw.githubusercontent.com/andaraGui/pokemon-infinity-mmo-extension/*"],
  "commands": {
    "toggle-overlay": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Abrir/fechar o overlay do Infinity MMO Extension"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "app.js",
        "battle.html",
        "battle.js",
        "chart.html",
        "chart.js",
        "auction.html",
        "auction.js",
        "pixel-theme.css",
        "myPokemons.html",
        "myPokemons.js",
        "components/*.js",
        "components/*.css",
        "data/*.js",
        "icons/types/*.png",
        "icons/types/colored/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
